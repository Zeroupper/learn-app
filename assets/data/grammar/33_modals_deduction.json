  "sections": [
    {
      "heading_hu": "Következtetés: must / might / can't",
      "body_hu": "'must' = biztos (logikus következtetés), 'might/may/could' = talán, 'can't' = kizárt. Utánuk alapalak.",
      "examples": [
        {
          "en": "He must be tired.",
          "hu": "Biztosan fáradt."
        },
        {
          "en": "She can't be at home.",
          "hu": "Nem lehet otthon."
        }
      ]
    },
    {
      "heading_hu": "Kötelezettség: must vs have to, mustn't",
      "body_hu": "'must' belső/erős kötelezettség, 'have to' külső szabály. 'mustn't' = tilos; 'don't have to' = nem kötelező (más jelentés!).",
      "examples": [
        {
          "en": "You mustn't park here.",
          "hu": "Itt tilos parkolni."
        },
        {
          "en": "You don't have to come.",
          "hu": "Nem kötelező jönnöd."
        }
      ]
    }
  ],
