{
  "id": "questions",
  "title_hu": "Kérdések: do / does / did",
  "subtitle_hu": "Segédige a kérdésekhez",
  "level": "a1",
  "sections": [
    {
      "heading_hu": "Miért kell segédige?",
      "body_hu": "A magyarban a kérdést hanglejtéssel jelezzük. Az angolban a legtöbb igénél KÖTELEZŐ segédige a kérdésben és a tagadásban: do / does (jelen), did (múlt). A főige ilyenkor alapalakban marad!",
      "examples": [
        {
          "en": "Do you like coffee?",
          "hu": "Szereted a kávét?"
        },
        {
          "en": "Does she speak English?",
          "hu": "Beszél angolul? (does + speak, nem speaks!)"
        },
        {
          "en": "Did they arrive?",
          "hu": "Megérkeztek?"
        }
      ]
    },
    {
      "heading_hu": "do vs. does vs. did",
      "body_hu": "does → he/she/it (jelen). do → I/you/we/they (jelen). did → mindenki (múlt). A -s vagy a múlt jele a segédigén van, ezért a főige alapalakban marad.",
      "examples": [
        {
          "en": "Where do you live?",
          "hu": "Hol laksz?"
        },
        {
          "en": "What does he want?",
          "hu": "Mit akar?"
        },
        {
          "en": "When did you leave?",
          "hu": "Mikor mentél el?"
        }
      ]
    },
    {
      "heading_hu": "Tagadás",
      "body_hu": "Ugyanez a segédige a tagadásban: don't / doesn't / didn't + alapige.",
      "examples": [
        {
          "en": "I don't know.",
          "hu": "Nem tudom."
        },
        {
          "en": "She doesn't eat meat.",
          "hu": "Nem eszik húst."
        },
        {
          "en": "We didn't see it.",
          "hu": "Nem láttuk."
        }
      ]
    }
  ],
