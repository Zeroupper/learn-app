  "title_hu": "Függő beszéd: reported speech",
  "subtitle_hu": "She said she was tired – idézés",
  "level": "b1",
  "sections": [
    {
      "heading_hu": "Igeidő-eltolás (backshift)",
      "body_hu": "Függő beszédben az igeidő egy lépéssel hátrébb csúszik: present → past, past → past perfect, will → would.",
      "examples": [
        {
          "en": "She said, \"I am tired.\" → She said she was tired.",
          "hu": "Azt mondta, fáradt."
        },
        {
          "en": "He said, \"I will call.\" → He said he would call.",
          "hu": "Azt mondta, felhív."
        }
      ]
    },
    {
      "heading_hu": "say vs tell, névmások és idő",
      "body_hu": "'tell' után áll a személy (tell me), 'say' után nem. A névmások és időhatározók is igazodnak: now → then, today → that day.",
      "examples": [
        {
          "en": "He told me he was busy.",
          "hu": "Azt mondta nekem, elfoglalt."
        },
        {
          "en": "She said she lived there.",
          "hu": "Azt mondta, ott lakik."
        }
      ]
    }
  ],
