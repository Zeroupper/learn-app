{
  "id": "to_be",
  "title_hu": "A „to be” ige (vagyok, vagy, van…)",
  "subtitle_hu": "am / is / are",
  "level": "a1",
  "sections": [
    {
      "heading_hu": "A három alak",
      "body_hu": "A „to be” (lenni) ige a jelenben három alakot vesz fel: I → am, he/she/it → is, we/you/they → are. Magyarul a „van” gyakran elmarad, angolul viszont KÖTELEZŐ kitenni!",
      "examples": [
        {
          "en": "I am tired.",
          "hu": "Fáradt vagyok."
        },
        {
          "en": "She is a teacher.",
          "hu": "Ő tanár."
        },
        {
          "en": "They are at home.",
          "hu": "Otthon vannak."
        }
      ]
    },
    {
      "heading_hu": "Rövid alakok és tagadás",
      "body_hu": "A beszélt nyelvben összevonjuk: I'm, you're, he's, she's, it's, we're, they're. Tagadáshoz a „not” szót tesszük az ige után: is not = isn't, are not = aren't.",
      "examples": [
        {
          "en": "I'm happy.",
          "hu": "Boldog vagyok."
        },
        {
          "en": "He isn't here.",
          "hu": "Ő nincs itt."
        },
        {
          "en": "We aren't ready.",
          "hu": "Nem vagyunk készen."
        }
      ]
    },
    {
      "heading_hu": "Kérdés",
      "body_hu": "Kérdésnél az igét előrehozzuk az alany elé (nincs szükség segédigére).",
      "examples": [
        {
          "en": "Are you a student?",
          "hu": "Diák vagy?"
        },
        {
          "en": "Is she your sister?",
          "hu": "Ő a nővéred?"
        }
      ]
    }
  ],
