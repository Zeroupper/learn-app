  "id": "demonstratives",
  "title_hu": "Mutató névmások: this / that / these / those",
  "subtitle_hu": "Ez / az, ezek / azok",
  "level": "a1",
  "sections": [
    {
      "heading_hu": "this / that – egyes szám",
      "body_hu": "A 'this' közeli dolgot jelöl (ez, itt), a 'that' távolit (az, ott). Egyes számú főnév előtt vagy önállóan állnak.",
      "examples": [
        {
          "en": "This is my car.",
          "hu": "Ez az én autóm. (közel)"
        },
        {
          "en": "That is your seat.",
          "hu": "Az a te helyed. (távol)"
        }
      ]
    },
    {
      "heading_hu": "these / those – többes szám",
      "body_hu": "Többes számban 'these' (ezek, közel) és 'those' (azok, távol). Utánuk többes számú főnév áll.",
      "examples": [
        {
          "en": "These books are new.",
          "hu": "Ezek a könyvek újak."
        },
        {
          "en": "Those cars are fast.",
          "hu": "Azok az autók gyorsak."
        }
      ]
    }
  ],
