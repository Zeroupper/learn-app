  "sections": [
    {
      "heading_hu": "Képzés: be + 3. alak",
      "body_hu": "A szenvedő szerkezetben a cselekvés TÁRGYA a fontos, nem a végrehajtó. Képzés: a 'be' megfelelő ideje + past participle.",
      "examples": [
        {
          "en": "English is spoken here.",
          "hu": "Itt angolul beszélnek."
        },
        {
          "en": "The house was built in 1900.",
          "hu": "A házat 1900-ban építették."
        }
      ]
    },
    {
      "heading_hu": "A végrehajtó: by",
      "body_hu": "Ha fontos, ki végezte, 'by' + cselekvő. Sokszor viszont elhagyjuk, mert nem lényeges vagy nem ismert.",
      "examples": [
        {
          "en": "The book was written by Orwell.",
          "hu": "A könyvet Orwell írta."
        },
        {
          "en": "My car was stolen.",
          "hu": "Ellopták az autómat."
        }
      ]
    }
  ],
