{
  "id": "comparatives",
  "title_hu": "Fokozás: comparative és superlative",
  "subtitle_hu": "bigger, the biggest",
  "level": "a2",
  "sections": [
    {
      "heading_hu": "Rövid melléknevek: -er / -est",
      "body_hu": "Egy szótagú (és néhány kétszótagú) melléknévnél: középfok -er + than, felsőfok the + -est. Ha rövid magánhangzó + mássalhangzó a vég, a mássalhangzót duplázzuk (big → bigger).",
      "examples": [
        {
          "en": "This box is bigger than that one.",
          "hu": "Ez a doboz nagyobb, mint az."
        },
        {
          "en": "Today is the hottest day.",
          "hu": "Ma van a legmelegebb nap."
        }
      ]
    },
    {
      "heading_hu": "Hosszú melléknevek: more / most",
      "body_hu": "Két vagy több szótagú melléknévnél nem toldalékolunk, hanem: középfok more + melléknév + than, felsőfok the most + melléknév.",
      "examples": [
        {
          "en": "This film is more interesting than that one.",
          "hu": "Ez a film érdekesebb, mint az."
        },
        {
          "en": "She is the most intelligent student.",
          "hu": "Ő a legokosabb diák."
        }
      ]
    },
    {
      "heading_hu": "Rendhagyó alakok",
      "body_hu": "Néhány gyakori melléknév rendhagyó: good → better → the best; bad → worse → the worst; far → further → the furthest.",
      "examples": [
        {
          "en": "This is better than before.",
          "hu": "Ez jobb, mint korábban."
        },
        {
          "en": "It was the worst day of my life.",
          "hu": "Életem legrosszabb napja volt."
        }
      ]
    }
  ],
