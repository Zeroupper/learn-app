{
  "id": "prepositions",
  "title_hu": "Elöljárók: in / on / at",
  "subtitle_hu": "Hely és idő",
  "level": "a2",
  "sections": [
    {
      "heading_hu": "Hely: in / on / at",
      "body_hu": "in = zárt téren belül (in a room, in a city). on = felületen (on the table, on the wall). at = konkrét pontnál (at the door, at the bus stop).",
      "examples": [
        {
          "en": "The keys are in the drawer.",
          "hu": "A kulcsok a fiókban vannak."
        },
        {
          "en": "The picture is on the wall.",
          "hu": "A kép a falon van."
        },
        {
          "en": "I'm waiting at the station.",
          "hu": "Az állomásnál várok."
        }
      ]
    },
    {
      "heading_hu": "Idő: in / on / at",
      "body_hu": "in = hónap, év, évszak, napszak (in May, in 2020, in the morning). on = nap, dátum (on Monday, on 5th May). at = óra, pontos időpont (at 7 o'clock, at night).",
      "examples": [
        {
          "en": "I was born in 1990.",
          "hu": "1990-ben születtem."
        },
        {
          "en": "See you on Friday.",
          "hu": "Pénteken találkozunk."
        },
        {
          "en": "The film starts at 8 p.m.",
          "hu": "A film este 8-kor kezdődik."
        }
      ]
    }
  ],
