{
  "id": "there_is_are",
  "title_hu": "There is / there are",
  "subtitle_hu": "Létezés kifejezése",
  "level": "a1",
  "sections": [
    {
      "heading_hu": "Mit jelent?",
      "body_hu": "A „there is / there are” szerkezettel azt fejezzük ki, hogy valami létezik vagy valahol van — magyarul „van / vannak”. Egyes számnál „there is”, többes számnál „there are”.",
      "examples": [
        {
          "en": "There is a book on the table.",
          "hu": "Van egy könyv az asztalon."
        },
        {
          "en": "There are three cats in the garden.",
          "hu": "Három macska van a kertben."
        }
      ]
    },
    {
      "heading_hu": "Tagadás és kérdés",
      "body_hu": "Tagadás: there isn't / there aren't. Kérdés: Is there…? / Are there…? A rövid válasz: Yes, there is. / No, there aren't.",
      "examples": [
        {
          "en": "There isn't any milk.",
          "hu": "Nincs tej."
        },
        {
          "en": "Are there any questions?",
          "hu": "Vannak kérdések?"
        },
        {
          "en": "Is there a bank near here?",
          "hu": "Van a közelben bank?"
        }
      ]
    }
  ],
