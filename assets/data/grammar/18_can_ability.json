    {
      "heading_hu": "can = tud, képes rá",
      "body_hu": "A 'can' képességet fejez ki. Utána a főige ALAPALAKBAN áll, 'to' nélkül. he/she/it után sem kap -s-t: she can, nem 'cans'.",
      "examples": [
        {
          "en": "I can swim.",
          "hu": "Tudok úszni."
        },
        {
          "en": "She can speak French.",
          "hu": "Tud franciául."
        }
      ]
    },
    {
      "heading_hu": "Tagadás és kérdés",
      "body_hu": "Tagadás: cannot / can't. Kérdés: Can you…? A 'can' nem használ do/does segédigét.",
      "examples": [
        {
          "en": "He can't drive.",
          "hu": "Nem tud vezetni."
        },
        {
          "en": "Can you help me?",
          "hu": "Tudsz segíteni?"
        }
      ]
    }
  ],
